# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/delivery_optimization
# For Docker Compose, use:
# MONGO_URI=mongodb://mongodb:27017/delivery_optimization

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Server Ports
PORT=5000
FRONTEND_URL=http://localhost:3000

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8000
# For Docker Compose, use:
# ML_SERVICE_URL=http://ml-service:8000

# Simulation Configuration
SIMULATION_SPEED=1
CITY_BOUNDS_LAT=22.7196
CITY_BOUNDS_LNG=75.8577
